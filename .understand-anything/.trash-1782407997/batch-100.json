    {
      "id": "file:packages/engine/Source/Shaders/CloudCollectionFS.glsl",
      "type": "file",
      "name": "CloudCollectionFS.glsl",
      "filePath": "packages/engine/Source/Shaders/CloudCollectionFS.glsl",
      "summary": "CloudCollection 的片元 shader：从相机射线投射椭球云体，结合 Gardner 1985 纹理函数、Lambert/Phong 光照与三层 Worley 噪声采样，生成具有侵蚀边缘与体积感的云团颜色与透明度。",
      "tags": ["shader", "fragment", "clouds", "raycasting", "noise", "lighting"],
      "complexity": "complex",
      "languageNotes": "基于 Gardner 1985《Visual Simulation of Clouds》的云纹理函数，叠加 Worley 噪声做边缘侵蚀，并在椭球空间内做光线-椭球求交。"
    },
    {
      "id": "function:packages/engine/Source/Shaders/CloudCollectionFS.glsl:drawCloud",
      "type": "function",
      "name": "drawCloud",
      "filePath": "packages/engine/Source/Shaders/CloudCollectionFS.glsl",
      "lineRange": [161, 230],
      "summary": "对光线与云椭球求交，计算 Lambert/Phong/Gardner 纹理光照强度，并叠加三层 Worley 噪声调整透明度与边缘侵蚀，输出最终云团颜色与 alpha。",
      "tags": ["shader", "clouds", "raycasting", "lighting", "noise"],
      "complexity": "complex"
    },
    {
      "id": "function:packages/engine/Source/Shaders/CloudCollectionFS.glsl:sampleNoiseTexture",
      "type": "function",
      "name": "sampleNoiseTexture",
      "filePath": "packages/engine/Source/Shaders/CloudCollectionFS.glsl",
      "lineRange": [51, 65],
      "summary": "在三轴上做三线性插值采样 3D 噪声纹理，返回体素邻域平滑后的 vec4 噪声值。",
      "tags": ["shader", "clouds", "noise", "texture", "interpolation"],
      "complexity": "moderate"
    },
    {
      "id": "function:packages/engine/Source/Shaders/CloudCollectionFS.glsl:intersectEllipsoid",
      "type": "function",
      "name": "intersectEllipsoid",
      "filePath": "packages/engine/Source/Shaders/CloudCollectionFS.glsl",
      "lineRange": [98, 113],
      "summary": "将射线变换到单位球空间调用 intersectSphere 求交，再把结果变换回椭球空间，处理过小尺度导致的退化和 slice 切片。",
      "tags": ["shader", "clouds", "raycasting", "geometry"],
      "complexity": "moderate"
    },
    {
      "id": "function:packages/engine/Source/Shaders/CloudCollectionFS.glsl:intersectSphere",
      "type": "function",
      "name": "intersectSphere",
      "filePath": "packages/engine/Source/Shaders/CloudCollectionFS.glsl",
      "lineRange": [68, 94],
      "summary": "对中心在原点、半径 0.5 的单位球做射线求交，返回交点与法线，并支持按 slice 做平面切片。",
      "tags": ["shader", "clouds", "raycasting", "geometry"],
      "complexity": "moderate"
    },
    {
      "id": "function:packages/engine/Source/Shaders/CloudCollectionFS.glsl:T",
      "type": "function",
      "name": "T",
      "filePath": "packages/engine/Source/Shaders/CloudCollectionFS.glsl",
      "lineRange": [136, 149],
      "summary": "源自 Gardner 1985 的云纹理函数，对 5 个八度的相位偏移正弦项求和，生成云表面的对比度纹理值。",
      "tags": ["shader", "clouds", "noise", "gardner", "texture"],
      "complexity": "moderate"
    },
    {
      "id": "function:packages/engine/Source/Shaders/CloudCollectionFS.glsl:main",
      "type": "function",
      "name": "main",
      "filePath": "packages/engine/Source/Shaders/CloudCollectionFS.glsl",
