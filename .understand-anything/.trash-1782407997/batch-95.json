      "tags": ["shader", "glsl", "vertex", "point-primitive", "float64"],
      "complexity": "moderate",
      "languageNotes": "通过 #ifdef USE_FLOAT64 在 positionHigh/Low 分量相对眼睛的编码与单一 position 属性之间切换。"
    },
