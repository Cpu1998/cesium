    {
      "id": "file:packages/engine/Source/Shaders/BrdfLutGeneratorFS.glsl",
      "type": "file",
      "name": "BrdfLutGeneratorFS.glsl",
      "filePath": "packages/engine/Source/Shaders/BrdfLutGeneratorFS.glsl",
      "summary": "片元着色器，使用 Hammersley 序列与 GGX 重要性采样预计算 BRDF 积分查找表（LUT），用于基于物理的图像光照（PBR）中拆分求和近似的环境光项。",
      "tags": ["shader", "glsl", "pbr", "brdf", "image-based-lighting"],
      "complexity": "complex",
      "languageNotes": "实现了 Van der Corput 根逆序列、importanceSampleGGX 微表面采样以及 Smith 联合 GGX 几何可见性函数，1024 次采样积分。"
    },
    {
      "id": "file:packages/engine/Source/Shaders/BufferPointMaterialFS.glsl",
