      "name": "BufferPointMaterialFS.glsl",
      "filePath": "packages/engine/Source/Shaders/BufferPointMaterialFS.glsl",
      "summary": "缓冲点图元的片元着色器，根据到点中心的距离与 fwidth 抗锯齿计算内外半径的 smoothstep 混合，输出带描边和透明度的圆形点。",
      "tags": ["shader", "glsl", "fragment", "point-primitive", "anti-aliasing"],
      "complexity": "simple"
    },
